# ---- mode -----------------------------------------------------------------
# paper (default) simulates fills against LIVE order books with real fees.
# live requires BOTH POLY_MODE=live and POLY_LIVE_TRADING_CONFIRMED=true.
POLY_MODE=paper
POLY_LIVE_TRADING_CONFIRMED=false
POLY_DB_PATH=data/polyagent.db
POLY_KILL_FILE=data/KILL
POLY_LOG_LEVEL=INFO

# ---- live credentials (never commit these) -----------------------------------
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=
# 0 = EOA wallet, 1 = email/Magic proxy, 2 = browser-wallet proxy
POLY_SIGNATURE_TYPE=1

# ---- capital & risk ------------------------------------------------------
POLY_STARTING_CAPITAL=1000
POLY_KELLY_FRACTION=0.25
POLY_MAX_POSITION_PCT=0.05
POLY_MAX_EVENT_PCT=0.10
POLY_MAX_TOTAL_EXPOSURE_PCT=0.60
POLY_MIN_CASH_RESERVE_PCT=0.20
POLY_MAX_DRAWDOWN_PCT=0.20
POLY_DAILY_LOSS_LIMIT_PCT=0.08
POLY_MIN_ORDER_USD=2
POLY_MAX_ORDER_USD=250

# ---- signal thresholds -----------------------------------------------------
POLY_MIN_EDGE=0.03
POLY_MIN_CONFIDENCE=0.80
POLY_MAX_SPREAD=0.06
POLY_ARB_MIN_PROFIT=0.005

# ---- wallet intelligence -------------------------------------------------
POLY_WALLET_MIN_TRADES=50
POLY_WALLET_MIN_RESOLVED_MARKETS=15
POLY_WALLET_MIN_DAYS_ACTIVE=30
POLY_WALLET_SEED_COUNT=200
POLY_WALLET_REFRESH_MINUTES=360

# ---- loop ------------------------------------------------------------------
POLY_SCAN_INTERVAL_SEC=60
POLY_MARKETS_PER_SCAN=150

# ---- news (comma-separated RSS/Atom URLs; optional) ---------------------------
POLY_NEWS_FEEDS=

# ---- dashboard -------------------------------------------------------------
POLY_DASHBOARD_HOST=127.0.0.1
POLY_DASHBOARD_PORT=8080
# set this if the dashboard is reachable by anyone but you
POLY_DASHBOARD_TOKEN=
